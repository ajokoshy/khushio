# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon pooled connection string (the running app and the seed script). The SQL files in
# drizzle/migrations are pasted into the Neon SQL Editor, so no direct string is needed to deploy.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/khushio?sslmode=require
# Optional: Neon direct string, only for `npm run db:studio`
DATABASE_URL_UNPOOLED=

# Auth. Use a DIFFERENT AUTH_SECRET for Preview and Production.
# There is no admin username or password here: the admin is a row in the `users` table
# (create or change it with drizzle/migrations/set-admin.sql).
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# Reserved for repository/route integration tests from Release 3A (none exist yet). Neon test branch, never production.
TEST_DATABASE_URL=

# Cloudinary (Phase 3B). Server-only secrets: never prefix with NEXT_PUBLIC_
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
