# Copy to .env.local for local work; add the same names in Vercel > Settings > Environment Variables. Never commit real values.
DATABASE_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=   # from: npm run hash -- "your password"
AUTH_SECRET=           # any random 32+ character string
NEXT_PUBLIC_SITE_URL=https://khushio.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=   # server-only; never commit or expose

# Optional cost guards (all have safe defaults)
MEDIA_MAX_ITEMS=500       # most images the media library will accept
DB_SOFT_LIMIT_MB=450      # database budget shown on Admin > Costs (match your Neon plan)
AFFILIATE_STRICT_DOMAINS= # set to 1 to reject links for merchants with no approved domains
MEDIA_PROVIDER=           # leave empty for Cloudinary; "external" disables uploads
CRON_SECRET=              # optional: enables GET /api/maintenance for a daily Vercel cron job
