# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon: pooled for the app, direct for migrations
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/khushio?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/khushio?sslmode=require

# Auth (Phase 2A). Use a DIFFERENT AUTH_SECRET for Preview and Production.
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# Local only, used by `npm run auth:create-admin`. Never add these to Vercel.
# The password is typed at a hidden prompt, never stored in a file or variable.
ADMIN_EMAIL=
ADMIN_NAME=

# Optional: a dedicated Neon test branch for `npm test` integration tests (skipped when empty)
TEST_DATABASE_URL=

# Cloudinary (Phase 3). Server-only secrets: never prefix with NEXT_PUBLIC_
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
